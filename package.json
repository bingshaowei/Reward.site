{
  "name": "internal-bounty-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:local": "tsx scripts/local-dev.ts",
    "build": "next build",
    "build:scripts": "node scripts/bundle.mjs",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "admin:init": "tsx --env-file=.env.local scripts/init-admin.ts",
    "cleanup": "tsx scripts/cleanup.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.4",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
